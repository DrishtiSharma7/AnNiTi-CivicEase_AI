APP_ENV=dev                      # "production" enforces real secrets and HTTPS redirect
DATABASE_URL=sqlite:///./civicease.db   # postgresql+psycopg://user:pass@host/db for Postgres
JWT_SECRET=change-me-long-random
PEPPER=change-me-long-random     # HMAC key for ID digests, signed URLs, approval tokens
# --- encryption keys (KMS) ---
KMS_MODE=local                   # local = MASTER_KEY_B64 below | gcp = Google Cloud KMS (key never leaves KMS)
MASTER_KEY_B64=                  # python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
GCP_KMS_KEY=                     # projects/P/locations/L/keyRings/R/cryptoKeys/K
# --- storage (keep the API stateless) ---
STORAGE_BACKEND=local            # local | gcs
STORAGE_DIR=./storage
GCS_BUCKET=
MAX_UPLOAD_MB=5
DOC_RETENTION_DAYS=30            # auto-expiry of stored documents
# --- limits ---
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
REDIS_URL=                       # set for multi-instance rate limiting
LLM_DAILY_QUOTA_PER_USER=30
LLM_MAX_CONCURRENT=4
# --- models (ids live here, since previews retire quickly) ---
USE_MOCK_LLM=true                # false = call Gemini (needs GEMINI_API_KEY)
GEMINI_API_KEY=
MODEL_FLASH=gemini-2.5-flash
MODEL_LITE=gemini-2.5-flash-lite
MODEL_EMBED=gemini-embedding-001
MODEL_TTS=gemini-2.5-flash-preview-tts
EMBED_DIM=256
ESCALATE_BELOW_CONFIDENCE=0.75   # cheapest model first, escalate only below this
# --- privacy: rules and OCR run as code before any model call ---
LOCAL_OCR=false                  # true = local OCR (pytesseract/pypdf), redact PII, send text only
REQUIRE_LOCAL_REDACTION=false    # true = never send raw document images to a model
USE_PGVECTOR=false               # true + PostgreSQL with the pgvector extension
# --- browser worker (separate, sandboxed service) ---
ALLOWED_PORTAL_DOMAINS=localhost,127.0.0.1
PORTAL_BASE_URL=                 # e.g. http://api:8000 when the worker runs in Docker
USE_PLAYWRIGHT=false
WORKER_URL=                      # e.g. http://worker:9000 (empty = in-process)
WORKER_SHARED_SECRET=change-me-long-random
# --- operations ---
JUDGE_MODE=true
METRICS_TOKEN=                   # set to enable GET /metrics
FORCE_HTTPS=                     # defaults to true in production
CORS_ORIGINS=http://localhost:3000
REVIEWER_EMAILS=                 # comma-separated; these accounts become rule-pack reviewers
ALLOW_SELF_APPROVE=              # defaults to false in production (four-eyes on rule packs)
OFFICIAL_DOMAIN_SUFFIXES=        # extra allowed source domains besides gov.in and nic.in
