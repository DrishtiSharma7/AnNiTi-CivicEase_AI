# Sandboxed browser worker: only the files it needs, no database, no storage, no model keys.
FROM mcr.microsoft.com/playwright/python:v1.44.0-jammy
WORKDIR /srv
RUN pip install --no-cache-dir fastapi "uvicorn[standard]" pyjwt cryptography
COPY app/__init__.py app/portal.py app/security.py ./app/
COPY worker ./worker
RUN useradd -m worker
USER worker
EXPOSE 9000
CMD ["uvicorn", "worker.main:app", "--host", "0.0.0.0", "--port", "9000"]
